# Copy to local.env (untracked, gitignored) and fill in. Plain KEY=value lines;
# sourced by slice1/hub/launch.sh, slice1/run.sh and frame/fully_watch.sh.
BOX3_HOST=<box3-ip>            # BOX-3 address (ESPHome API 6053)
HUB_HOST_IP=<hub-ip>           # hub LAN IP the BOX-3 fetches TTS from (run.sh falls back to en0/en1)
FRAME_HOST=<frame-ip>          # kitchen frame, adb over Wi-Fi
FRAME_ADB_PORT=5555
FRAME_ADB_SERIAL=<frame-adb-serial>   # USB adb fallback (reference only)
PRINTER_MAC=<printer-mac>      # used as: tools/btprint "$PRINTER_MAC" slip.bin 1
CF_ACCOUNT_ID=<acct>           # Cloudflare account id (Alexa queue puller)
CF_QUEUE_ID=<queue-id>         # Cloudflare queue id of womble-alexa
# Brain key is the Keychain item womble-brain-xai (account $USER), not a line in this file.
# security add-generic-password -a $USER -s womble-brain-xai -U -w
VAD_TRAIL_SIL_S=1.2            # end-of-speech pause in seconds (0.65 is the old cutoff)
BRAIN_TIMEOUT_S=4              # BOX-3 wait on the brain before "Connection unavailable."
BRAIN_WEB_SEARCH=1             # 0 leaves xAI web_search off the tool list
# XAI_BRAIN_API_KEY=           # optional override; leave unset so the hub reads Keychain
